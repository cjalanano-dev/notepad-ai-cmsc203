<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!-- Automatically rebuild Tailwind CSS before build if npx is available -->
  <Target Name="BuildTailwind" BeforeTargets="BeforeBuild">
    <Exec Command="cmd.exe /c &quot;npx -y tailwindcss@3.4.17 -i ./Styles/input.css -o ./wwwroot/css/app.css --minify&quot;" ContinueOnError="true" />
  </Target>

  <!-- Sync .env or environment variables into wwwroot/appsettings.Development.json for Blazor WASM -->
  <Target Name="SyncEnvToAppSettings" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$key = $env:OPENROUTER_API_KEY; $model = if ($env:OPENROUTER_MODEL) { $env:OPENROUTER_MODEL } else { 'google/gemma-4-26b-a4b-it:free' }; if (Test-Path '.env') { Get-Content '.env' | ForEach-Object { if ($_ -match '^\s*(?:OPENROUTER_API_KEY|GEMINI_API_KEY)\s*=\s*(.*)\s*$') { $val = $Matches[1].Trim().Trim([char]34, [char]39); if ($val) { $key = $val } } elseif ($_ -match '^\s*(?:OPENROUTER_MODEL|GEMINI_MODEL)\s*=\s*(.*)\s*$') { $val = $Matches[1].Trim().Trim([char]34, [char]39); if ($val) { $model = $val } } } }; $obj = @{ OpenRouter = @{ ApiKey = [string]$key; Model = [string]$model } }; $obj | ConvertTo-Json -Depth 3 | Set-Content -Path 'wwwroot/appsettings.Development.json' -Encoding UTF8&quot;" ContinueOnError="true" />
  </Target>

</Project>
