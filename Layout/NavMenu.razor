@inject AppStateService AppState

<aside class="h-full bg-surface border-r border-line flex flex-col transition-[width] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] z-40 select-none @(AppState.IsSidebarCollapsed ? "w-[68px]" : "w-[270px]")">
    <!-- Header / Brand -->
    <div class="p-4 border-b border-line flex items-center justify-between">
        <div class="flex items-center gap-3 overflow-hidden">
            <img src="assets/logo/conext-logo-256.webp" alt="Notepad AI" class="w-8 h-8 rounded-[9px] object-cover flex-shrink-0 shadow-[0_2px_10px_rgba(0,0,0,0.4)]" />
            @if (!AppState.IsSidebarCollapsed)
            {
                <span class="text-[1.05rem] font-bold tracking-tight text-ink whitespace-nowrap">Notepad AI</span>
            }
        </div>
        <button class="bg-transparent border-none text-ink-secondary hover:text-ink hover:bg-surface-raised p-1.5 rounded-lg flex items-center justify-center transition-colors cursor-pointer" @onclick="AppState.ToggleSidebar" title="@(AppState.IsSidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")">
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                @if (AppState.IsSidebarCollapsed)
                {
                    <rect width="18" height="18" x="3" y="3" rx="2"/><path d="m9 9 3 3-3 3"/><path d="M15 3v18"/>
                }
                else
                {
                    <rect width="18" height="18" x="3" y="3" rx="2"/><path d="m14 9-3 3 3 3"/><path d="M9 3v18"/>
                }
            </svg>
        </button>
    </div>

    <!-- Quick Search Command Button -->
    <button class="mx-3.5 my-3 bg-surface-raised border border-line hover:border-line-strong hover:bg-surface-hover hover:text-ink rounded-[10px] px-3 py-2.5 text-ink-secondary flex items-center gap-2.5 cursor-pointer text-[0.825rem] transition-all" @onclick="() => AppState.IsCommandPaletteOpen = true" title="Search reviewers (Ctrl+K)">
        <svg class="w-[15px] h-[15px] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        @if (!AppState.IsSidebarCollapsed)
        {
            <span>Search</span>
            <kbd class="ml-auto text-[0.675rem] bg-canvas border border-line px-1.5 py-0.5 rounded-[5px] text-ink-muted">Ctrl+K</kbd>
        }
    </button>

    <!-- Main Navigation Section -->
    <div class="px-2.5 py-2 flex flex-col gap-[3px] border-b border-line">
        <button class="flex items-center gap-3 px-3 py-2 rounded-[10px] border-none text-[0.865rem] font-medium cursor-pointer w-full text-left transition-all whitespace-nowrap @(AppState.IsSidebarCollapsed ? "justify-center px-0" : "") @(AppState.ActiveView == "dashboard" ? "bg-surface-hover text-white font-semibold shadow-[0_1px_3px_rgba(0,0,0,0.25)]" : "bg-transparent text-ink-secondary hover:bg-surface-raised hover:text-ink")" @onclick='() => AppState.SetView("dashboard")'>
            <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            @if (!AppState.IsSidebarCollapsed)
            {
                <span>Recent</span>
            }
        </button>

        <button class="flex items-center gap-3 px-3 py-2 rounded-[10px] border-none text-[0.865rem] font-medium cursor-pointer w-full text-left transition-all whitespace-nowrap @(AppState.IsSidebarCollapsed ? "justify-center px-0" : "") @(AppState.ActiveView == "library" ? "bg-surface-hover text-white font-semibold shadow-[0_1px_3px_rgba(0,0,0,0.25)]" : "bg-transparent text-ink-secondary hover:bg-surface-raised hover:text-ink")" @onclick='() => AppState.SetView("library")'>
            <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/>
            </svg>
            @if (!AppState.IsSidebarCollapsed)
            {
                <span>Library</span>
            }
        </button>

        <button class="flex items-center gap-3 px-3 py-2 rounded-[10px] border-none text-[0.865rem] font-medium cursor-pointer w-full text-left transition-all whitespace-nowrap @(AppState.IsSidebarCollapsed ? "justify-center px-0" : "") @(AppState.ActiveView == "trash" ? "bg-surface-hover text-white font-semibold shadow-[0_1px_3px_rgba(0,0,0,0.25)]" : "bg-transparent text-ink-secondary hover:bg-surface-raised hover:text-ink")" @onclick='() => AppState.SetView("trash")'>
            <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
            </svg>
            @if (!AppState.IsSidebarCollapsed)
            {
                <span>Trash</span>
                <span class="ml-auto bg-surface-raised text-ink-muted text-[0.7rem] font-semibold px-2 py-0.5 rounded-full border border-line">@AppState.TrashedDocuments.Count</span>
            }
        </button>

        <button class="flex items-center gap-3 px-3 py-2 rounded-[10px] border-none text-[0.865rem] font-medium cursor-pointer w-full text-left transition-all whitespace-nowrap @(AppState.IsSidebarCollapsed ? "justify-center px-0" : "") @(AppState.ActiveView == "settings" ? "bg-surface-hover text-white font-semibold shadow-[0_1px_3px_rgba(0,0,0,0.25)]" : "bg-transparent text-ink-secondary hover:bg-surface-raised hover:text-ink")" @onclick='() => AppState.SetView("settings")'>
            <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
                <circle cx="12" cy="12" r="3"/>
            </svg>
            @if (!AppState.IsSidebarCollapsed)
            {
                <span>Settings</span>
            }
        </button>
    </div>

    <!-- Study Tools Section -->
    <div class="px-2.5 py-2 flex flex-col gap-[3px] border-b border-line">
        @if (!AppState.IsSidebarCollapsed)
        {
            <div class="text-[0.68rem] font-bold uppercase tracking-wider text-ink-muted px-3 pt-2 pb-1">Study Tools</div>
        }
        <button class="flex items-center gap-3 px-3 py-2 rounded-[10px] border-none text-[0.865rem] font-medium cursor-pointer w-full text-left transition-all whitespace-nowrap @(AppState.IsSidebarCollapsed ? "justify-center px-0" : "") @(AppState.ActiveView == "quiz" ? "bg-surface-hover text-white font-semibold shadow-[0_1px_3px_rgba(0,0,0,0.25)]" : "bg-transparent text-ink-secondary hover:bg-surface-raised hover:text-ink")" @onclick='() => AppState.SetView("quiz")'>
            <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><path d="9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>
            </svg>
            @if (!AppState.IsSidebarCollapsed)
            {
                <span>Quiz</span>
            }
        </button>

        <button class="flex items-center gap-3 px-3 py-2 rounded-[10px] border-none text-[0.865rem] font-medium cursor-pointer w-full text-left transition-all whitespace-nowrap @(AppState.IsSidebarCollapsed ? "justify-center px-0" : "") @(AppState.ActiveView == "flashcards" ? "bg-surface-hover text-white font-semibold shadow-[0_1px_3px_rgba(0,0,0,0.25)]" : "bg-transparent text-ink-secondary hover:bg-surface-raised hover:text-ink")" @onclick='() => AppState.SetView("flashcards")'>
            <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.9a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 12.5-9.17 4.16a2 2 0 0 1-1.66 0L2 12.5"/><path d="m22 17.5-9.17 4.16a2 2 0 0 1-1.66 0L2 17.5"/>
            </svg>
            @if (!AppState.IsSidebarCollapsed)
            {
                <span>Flash-Card</span>
            }
        </button>

        <button class="flex items-center gap-3 px-3 py-2 rounded-[10px] border-none text-[0.865rem] font-medium cursor-pointer w-full text-left transition-all whitespace-nowrap @(AppState.IsSidebarCollapsed ? "justify-center px-0" : "") @(AppState.ActiveView == "essay" ? "bg-surface-hover text-white font-semibold shadow-[0_1px_3px_rgba(0,0,0,0.25)]" : "bg-transparent text-ink-secondary hover:bg-surface-raised hover:text-ink")" @onclick='() => AppState.SetView("essay")'>
            <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
            </svg>
            @if (!AppState.IsSidebarCollapsed)
            {
                <span>Essay</span>
            }
        </button>
    </div>

    <!-- User Profile Footer -->
    <div class="mt-auto px-4 py-3.5 bg-black/20 border-t border-line flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-surface-raised border border-line flex items-center justify-center text-[0.8rem] text-accent font-semibold flex-shrink-0">
            @(AppState.User.DisplayName?.Substring(0, 1).ToUpper() ?? "U")
        </div>
        @if (!AppState.IsSidebarCollapsed)
        {
            <div class="flex flex-col overflow-hidden leading-tight">
                <span class="text-[0.825rem] font-semibold text-ink truncate">@AppState.User.DisplayName</span>
                <span class="text-[0.72rem] text-ink-muted truncate">@AppState.User.Email</span>
            </div>
        }
    </div>
</aside>
