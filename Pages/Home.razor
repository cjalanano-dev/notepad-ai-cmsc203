@page "/"
@inject AppStateService AppState
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (AppState.ActiveView == "dashboard")
{
    <!-- DASHBOARD VIEW -->
    <div class="flex-1 overflow-y-auto px-4 py-5 sm:px-8 sm:py-7 lg:px-14 lg:py-9">
        <!-- Top Upload Zone with Real File Upload Support -->
        <div class="border border-line rounded-xl bg-surface p-5 sm:p-7 text-center transition-all mb-6 sm:mb-8 flex flex-col items-center justify-center hover:border-accent-border relative">
            <InputFile OnChange="HandleFileUpload" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" accept=".pdf,.txt,.md" />
            <div class="w-10 h-10 rounded-lg bg-surface-raised border border-line flex items-center justify-center text-accent mb-3">
                @if (isUploading)
                {
                    <svg class="animate-spin w-5 h-5 text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                }
                else
                {
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                        <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M12 12v9"/><path d="m16 16-4-4-4 4"/>
                    </svg>
                }
            </div>
            <div class="text-[0.925rem] font-medium text-ink mb-1">
                @(isUploading ? uploadProgressMessage : "Upload documents to get started")
            </div>
            <div class="text-[0.75rem] text-ink-muted">
                PDF, TXT, or Markdown
            </div>
        </div>

        <div class="mb-5 sm:mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
                <h1 class="text-xl sm:text-[1.35rem] font-semibold tracking-tight text-ink">Documents</h1>
                <p class="text-ink-secondary text-[0.825rem]">Select a document to review notes, inspect concepts, or chat.</p>
            </div>
            <span class="text-[0.75rem] text-ink-muted font-mono self-start sm:self-auto">@AppState.Documents.Count items</span>
        </div>

        @if (AppState.Documents.Count == 0)
        {
            <div class="border border-line rounded-xl bg-surface/50 p-8 sm:p-12 text-center flex flex-col items-center justify-center">
                <svg class="w-8 h-8 text-ink-muted mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <div class="text-[0.9rem] font-medium text-ink mb-1">No documents uploaded yet</div>
                <div class="text-[0.785rem] text-ink-muted max-w-sm">Drag and drop your study notes or research papers above to create interactive mind maps.</div>
            </div>
        }
        else
        {
            <!-- Reviewers Notebook Card Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-4 sm:gap-5">
                @foreach (var doc in AppState.Documents)
                {
                    <div class="bg-surface border border-line rounded-xl overflow-hidden cursor-pointer transition-all hover:border-accent-border hover:shadow-card-hover flex flex-col relative group" @onclick="() => AppState.SelectDocument(doc.Id)">
                        <button class="opacity-100 sm:opacity-0 group-hover:opacity-100 absolute top-2 right-2 bg-black/75 backdrop-blur-sm border border-line text-white hover:bg-danger hover:border-danger rounded-md p-1.5 cursor-pointer transition-all z-10" @onclick:stopPropagation="true" @onclick="() => AppState.MoveToTrash(doc.Id)" title="Delete document">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                            </svg>
                        </button>
                        <div class="h-[130px] w-full relative overflow-hidden bg-surface-raised">
                            <img src="@(doc.CoverUrl ?? "assets/notebook-covers/cover-01.jpg")" alt="Cover" class="w-full h-full object-cover" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                        </div>
                        <div class="p-4 flex flex-col flex-1">
                            <div class="text-[0.875rem] font-medium text-ink leading-snug mb-2 line-clamp-2" title="@doc.Filename">@doc.Filename</div>
                            <div class="text-[0.725rem] text-ink-muted flex items-center justify-between mt-auto pt-2 border-t border-line/60">
                                <span>@doc.ChunkCount passages</span>
                                <span>@doc.UploadedAt.ToString("MMM d")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}
else if (AppState.ActiveView == "workspace")
{
    <!-- WORKSPACE / CONCEPT GRAPH & REVIEWER CHAT -->
    <div class="flex h-full w-full overflow-hidden relative">
        <div class="flex-1 flex flex-col h-full relative canvas-bg overflow-hidden min-w-0">
            <!-- Top Floating Workspace Bar -->
            <div class="absolute top-2.5 sm:top-4 left-2.5 sm:left-5 right-2.5 sm:right-5 min-h-[48px] py-1.5 sm:py-0 bg-surface/95 backdrop-blur-md border border-line rounded-xl sm:rounded-lg flex flex-wrap items-center justify-between gap-2 px-3 sm:px-3.5 z-20 shadow-md">
                <div class="flex items-center gap-2 text-[0.85rem] font-medium text-ink min-w-0 flex-1 sm:flex-initial">
                    <button class="bg-surface-raised border border-line text-ink-secondary hover:text-ink hover:bg-surface-hover rounded-md p-1.5 flex items-center justify-center cursor-pointer transition-colors flex-shrink-0" @onclick='() => AppState.SetView("dashboard")' title="Back to Documents">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"/>
                        </svg>
                    </button>
                    <span class="max-w-[160px] sm:max-w-[260px] md:max-w-[340px] truncate text-ink font-semibold">
                        @(AppState.SelectedDocument?.Filename ?? "Document Workspace")
                    </span>
                </div>

                <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap">
                    <button class="bg-surface-raised border border-line text-ink-secondary hover:text-ink hover:bg-surface-hover rounded-md px-2 sm:px-2.5 py-1 text-[0.75rem] sm:text-[0.785rem] font-medium flex items-center gap-1 cursor-pointer transition-colors" @onclick="() => isSourcesPanelOpen = !isSourcesPanelOpen" title="View Sources">
                        <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                        </svg>
                        <span class="hidden xs:inline">Sources</span> <span class="text-ink-muted">(@(AppState.SelectedDocument?.Passages.Count ?? 0))</span>
                    </button>
                    <button class="bg-surface-raised border border-line text-ink-secondary hover:text-ink hover:bg-surface-hover rounded-md px-2 sm:px-2.5 py-1 text-[0.75rem] sm:text-[0.785rem] font-medium flex items-center gap-1 cursor-pointer transition-colors" @onclick='() => AppState.SetView("quiz")'>
                        <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>
                        </svg>
                        <span>Quiz</span>
                    </button>
                    <button class="bg-surface-raised border border-line text-ink-secondary hover:text-ink hover:bg-surface-hover rounded-md px-2 sm:px-2.5 py-1 text-[0.75rem] sm:text-[0.785rem] font-medium flex items-center gap-1 cursor-pointer transition-colors" @onclick='() => AppState.SetView("flashcards")'>
                        <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.9a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
                        </svg>
                        <span>Cards</span>
                    </button>
                    <button class="rounded-md px-2.5 sm:px-3 py-1 text-[0.75rem] sm:text-[0.785rem] font-semibold flex items-center gap-1.5 cursor-pointer transition-colors border @(isChatVisible ? "bg-accent text-white border-accent" : "bg-surface-raised border-line text-ink-secondary hover:bg-surface-hover hover:text-ink")" @onclick="() => isChatVisible = !isChatVisible">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/>
                        </svg>
                        <span>Chat</span>
                    </button>
                </div>
            </div>

            <!-- Mind Map Floating Zoom & Reset Toolbar -->
            <div class="absolute bottom-3 sm:bottom-5 left-3 sm:left-5 z-20 flex items-center gap-1 bg-surface/95 backdrop-blur-md border border-line rounded-lg p-1 select-none shadow-md">
                <button class="w-7 h-7 rounded bg-surface-raised hover:bg-surface-hover text-ink-secondary hover:text-ink flex items-center justify-center border border-line transition-colors" @onclick="ZoomIn" title="Zoom in">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                </button>
                <button class="w-7 h-7 rounded bg-surface-raised hover:bg-surface-hover text-ink-secondary hover:text-ink flex items-center justify-center border border-line transition-colors" @onclick="ZoomOut" title="Zoom out">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                </button>
                <div class="h-3.5 w-[1px] bg-line mx-0.5"></div>
                <button class="px-2 h-7 rounded bg-surface-raised hover:bg-surface-hover text-ink-secondary hover:text-ink flex items-center gap-1 text-[0.72rem] font-mono border border-line transition-colors" @onclick="ResetCanvasView" title="Reset view">
                    <span id="map-zoom-level-text">100%</span>
                </button>
            </div>

            <!-- Mind Map Helper Tooltip Hint -->
            <div class="absolute bottom-4 right-4 z-20 hidden md:flex items-center gap-2 bg-surface/90 backdrop-blur-md border border-line rounded-full px-3.5 py-1.5 text-[0.72rem] text-ink-muted select-none">
                <span>Drag nodes to organize • Drag canvas or scroll to pan & zoom</span>
            </div>

            <!-- Concept Graph Visualizer (Interactive Draggable Mind Map SVG) -->
            <svg id="concept-map-svg" class="graph-canvas w-full h-full" viewBox="0 0 900 650">
                <defs>
                    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                        <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#94a3b8" />
                    </marker>
                </defs>

                <!-- Panning and Zooming Viewport Container -->
                <g id="concept-viewport-group">
                    <!-- Edges / Connections -->
                    @foreach (var edge in AppState.CurrentEdges)
                    {
                        var source = AppState.CurrentNodes.FirstOrDefault(n => n.Id == edge.SourceNodeId);
                        var target = AppState.CurrentNodes.FirstOrDefault(n => n.Id == edge.TargetNodeId);
                        if (source != null && target != null)
                        {
                            var midX = (source.X + target.X) / 2;
                            var midY = (source.Y + target.Y) / 2;
                            <line id="edge-line-@edge.Id"
                                  data-edge-id="@edge.Id"
                                  data-source-id="@edge.SourceNodeId"
                                  data-target-id="@edge.TargetNodeId"
                                  x1="@source.X" y1="@source.Y"
                                  x2="@target.X" y2="@target.Y"
                                  stroke="#64748b"
                                  stroke-width="2.5"
                                  stroke-linecap="round"
                                  marker-end="url(#arrow)" />

                            @if (!string.IsNullOrWhiteSpace(edge.Relationship))
                            {
                                <g id="edge-label-@edge.Id" transform="translate(@midX, @midY)">
                                    <rect x="-44" y="-11" width="88" height="22" rx="5" fill="#0f172a" stroke="#475569" stroke-width="1.5" />
                                    <text x="0" y="3.5" text-anchor="middle" font-size="9.5" font-weight="600" fill="#cbd5e1" font-family="Plus Jakarta Sans">@edge.Relationship</text>
                                </g>
                            }
                        }
                    }

                    <!-- Nodes (Radial Mind Map Cards) -->
                    @foreach (var node in AppState.CurrentNodes)
                    {
                        var isSelected = AppState.SelectedNode?.Id == node.Id;
                        var isRoot = node.NodeType == "root";
                        var isSub = node.NodeType == "subconcept";

                        var nodeWidth = isRoot ? 210 : (isSub ? 160 : 180);
                        var nodeHeight = isRoot ? 72 : (isSub ? 52 : 62);
                        var halfW = nodeWidth / 2;
                        var halfH = nodeHeight / 2;

                        var nodeFill = isSelected ? "#1e293b" : (isRoot ? "#0f2038" : (isSub ? "#0b0f17" : "#111827"));
                        var nodeStroke = isSelected ? "#38bdf8" : (isRoot ? "#38bdf8" : (isSub ? "#334155" : "#475569"));

                        <g id="node-g-@node.Id"
                           class="graph-node"
                           data-node-id="@node.Id"
                           data-node-x="@node.X"
                           data-node-y="@node.Y"
                           data-half-w="@halfW"
                           data-half-h="@halfH"
                           transform="translate(@(node.X - halfW), @(node.Y - halfH))"
                           @onclick="() => AppState.SelectNode(node.Id)">
                            
                            <!-- Card Shape -->
                            <rect width="@nodeWidth" height="@nodeHeight" rx="@(isRoot ? "12" : "8")"
                                  fill="@nodeFill"
                                  stroke="@nodeStroke"
                                  stroke-width="@(isSelected ? "2.5" : (isRoot ? "2" : "1.25"))" />

                            @if (isRoot)
                            {
                                <rect x="0" y="0" width="4" height="@nodeHeight" rx="2" fill="#38bdf8" />
                            }

                            <!-- Concept Label & Subtitle -->
                            <text x="14" y="@(isSub ? 26 : 30)" font-size="@(isRoot ? "12.5" : (isSub ? "10.5" : "11.5"))" font-weight="600" fill="#f8fafc" font-family="Plus Jakarta Sans">@node.Label</text>
                            <text x="14" y="@(isSub ? 42 : 48)" font-size="@(isSub ? "8.5" : "9")" fill="#94a3b8" font-family="Plus Jakarta Sans">@(isRoot ? "Central Topic" : (isSub ? "Detail" : "Key Subtopic"))</text>
                        </g>
                    }
                </g>
            </svg>
        </div>

        <!-- Concept Explanation Modal -->
        @if (AppState.IsConceptModalOpen && AppState.SelectedDetail != null)
        {
            <div class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4 sm:p-6 animate-fade-in" @onclick="AppState.CloseConceptModal">
                <div class="w-full max-w-2xl bg-surface border border-line-strong rounded-2xl shadow-palette overflow-hidden flex flex-col max-h-[88vh]" @onclick:stopPropagation="true">
                    <!-- Modal Header -->
                    <div class="px-5 sm:px-6 py-4 border-b border-line flex items-center justify-between gap-3 bg-surface-raised/40">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="w-2 h-2 rounded-full bg-accent"></span>
                                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-accent font-mono">Concept Explanation</span>
                            </div>
                            <h2 class="text-lg sm:text-[1.25rem] font-bold text-ink leading-snug truncate">@AppState.SelectedDetail.Label</h2>
                        </div>
                        <button class="bg-surface-raised hover:bg-surface-hover text-ink-secondary hover:text-ink p-1.5 rounded-lg border border-line flex items-center justify-center transition-colors cursor-pointer flex-shrink-0" @onclick="AppState.CloseConceptModal" title="Close modal">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="6"/>
                            </svg>
                        </button>
                    </div>

                    <!-- Modal Body -->
                    <div class="flex-1 overflow-y-auto p-5 sm:p-6 flex flex-col gap-6">
                        <!-- Primary Explanation Block -->
                        <div>
                            <div class="text-[0.72rem] font-bold uppercase tracking-wider text-ink-muted mb-2">Core Summary & Explanation</div>
                            <div class="bg-surface-raised border border-line rounded-xl p-4 sm:p-5 text-sm sm:text-[0.92rem] leading-relaxed text-ink chat-prose shadow-sm">
                                @TextFormatter.ToFormattedHtml(AppState.SelectedDetail.Explanation)
                            </div>
                        </div>

                        <!-- Grounded Evidence & Citations -->
                        <div>
                            <div class="text-[0.72rem] font-bold uppercase tracking-wider text-ink-muted mb-2.5 flex items-center justify-between">
                                <span>Grounding Sources & Citations</span>
                                <span class="text-accent font-mono text-[0.7rem]">@AppState.SelectedDetail.Sources.Count references</span>
                            </div>

                            <div class="flex flex-col gap-3">
                                @if (!AppState.SelectedDetail.Sources.Any())
                                {
                                    <div class="p-4 bg-surface-raised border border-line rounded-xl text-[0.825rem] text-ink-muted italic text-center">
                                        No citations linked directly to this concept passage.
                                    </div>
                                }
                                else
                                {
                                    int srcIndex = 1;
                                    @foreach (var src in AppState.SelectedDetail.Sources)
                                    {
                                        <div class="bg-surface-raised border border-line rounded-xl p-4 hover:border-line-strong transition-all">
                                            <div class="flex items-center justify-between text-[0.72rem] text-ink-muted mb-2 pb-2 border-b border-line/60">
                                                <span class="font-mono text-accent font-semibold">Citation #@(srcIndex++)</span>
                                                <span class="font-mono bg-canvas border border-line px-2 py-0.5 rounded text-[0.68rem] text-ink-secondary">Page @src.PageNumber</span>
                                            </div>

                                            <p class="text-[0.835rem] text-ink-secondary leading-relaxed select-text">
                                                &ldquo;@src.Content.Trim()&rdquo;
                                            </p>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Modal Footer -->
                    <div class="px-5 sm:px-6 py-3.5 border-t border-line bg-surface-raised/40 flex items-center justify-end">
                        <button class="bg-surface-raised hover:bg-surface-hover text-ink border border-line hover:border-accent-border rounded-lg px-4 py-2 text-[0.85rem] font-medium cursor-pointer transition-colors" @onclick="AppState.CloseConceptModal">
                            Close
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Chat Drawer -->
        @if (isChatVisible)
        {
            <aside class="fixed inset-y-0 right-0 z-40 w-full sm:w-[400px] lg:static lg:w-[380px] h-full bg-surface border-l border-line flex flex-col shadow-2xl lg:shadow-none animate-fade-in">
                <div class="px-5 py-4 border-b border-line flex items-center justify-between">
                    <div>
                        <h2 class="text-[1rem] font-semibold text-ink">Reviewer Chat</h2>
                        <span class="text-[0.72rem] text-ink-muted">Ask questions about selected document</span>
                    </div>
                    <button class="bg-surface-raised hover:bg-surface-hover text-ink-secondary hover:text-ink p-1.5 rounded-lg border border-line flex items-center justify-center transition-colors cursor-pointer" @onclick="() => isChatVisible = false" title="Close chat">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="6"/>
                        </svg>
                    </button>
                </div>

                <div class="flex-1 overflow-y-auto p-4 flex flex-col gap-4">
                    @foreach (var msg in AppState.CurrentMessages)
                    {
                        var isUser = msg.Role == "user";
                        <div class="flex flex-col max-w-[90%] @(isUser ? "self-end" : "self-start")">
                            <div class="text-[0.675rem] font-medium mb-1 px-1 @(isUser ? "text-right text-ink-muted" : "text-ink-secondary")">
                                @(isUser ? "You" : "Reviewer")
                            </div>
                            <div class="@(isUser ? "bg-accent/15 border border-accent/30 text-ink rounded-lg px-3.5 py-2.5 text-[0.85rem] leading-relaxed" : "bg-surface-raised border border-line text-ink rounded-lg px-3.5 py-2.5 text-[0.85rem] leading-relaxed")">
                                @if (isUser)
                                {
                                    <div class="whitespace-pre-wrap">@msg.Content</div>
                                }
                                else
                                {
                                    <div class="chat-prose">
                                        @TextFormatter.ToFormattedHtml(msg.Content)
                                    </div>
                                }

                                @if (msg.Citations.Any())
                                {
                                    <div class="flex flex-wrap gap-1.5 mt-2.5 pt-2 border-t border-line/60">
                                        @foreach (var c in msg.Citations)
                                        {
                                            <div class="inline-flex items-center gap-1 bg-surface border border-line rounded px-2 py-0.5 text-[0.68rem] text-accent font-mono" title="@c.Excerpt">
                                                <span>p. @c.PageNumber</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (AppState.IsAiBusy)
                    {
                        <div class="flex flex-col max-w-[90%] self-start">
                            <div class="text-[0.675rem] font-medium mb-1 px-1 text-ink-secondary">Reviewer</div>
                            <div class="bg-surface-raised border border-line rounded-lg px-3.5 py-2.5 flex items-center gap-2 text-[0.825rem] text-ink-secondary">
                                <svg class="animate-spin w-3.5 h-3.5 text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                </svg>
                                <span>@(string.IsNullOrWhiteSpace(AppState.AiBusyMessage) ? "Analyzing..." : AppState.AiBusyMessage)</span>
                            </div>
                        </div>
                    }
                </div>

                <!-- Chat Input -->
                <div class="p-3 border-t border-line bg-surface">
                    <form @onsubmit="SendMessage" class="flex items-center gap-2 bg-canvas border border-line rounded-lg px-2.5 py-1 focus-within:border-accent transition-all">
                        <input type="text" class="flex-1 bg-transparent border-none outline-none text-ink text-[0.85rem] py-1.5 px-1 placeholder:text-ink-muted" placeholder="Ask about this document..." @bind="chatInputText" />
                        <button type="submit" class="bg-accent hover:bg-accent-hover text-white border-none rounded-md px-3 py-1.5 text-[0.8rem] font-semibold cursor-pointer transition-colors" title="Send message">
                            Send
                        </button>
                    </form>
                </div>
            </aside>
        }

        <!-- Source Management Drawer (NotebookLM Source Panel) -->
        @if (isSourcesPanelOpen && AppState.SelectedDocument != null)
        {
            <aside class="fixed inset-y-0 right-0 z-40 w-full sm:w-[400px] lg:static lg:w-[380px] h-full bg-surface/95 backdrop-blur-md border-l border-line flex flex-col shadow-2xl lg:shadow-none animate-fade-in">
                <div class="px-5 pt-5 pb-4 border-b border-line flex items-center justify-between">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="w-2 h-2 rounded-full bg-accent"></span>
                            <span class="text-[0.68rem] font-bold uppercase tracking-wider text-accent">Source Management</span>
                        </div>
                        <h2 class="text-[1.1rem] font-bold text-ink leading-tight">Document Passages</h2>
                    </div>
                    <button class="bg-surface-raised hover:bg-surface-hover text-ink-secondary hover:text-ink p-1.5 rounded-xl border border-line flex items-center justify-center transition-colors cursor-pointer interactive-btn" @onclick="() => isSourcesPanelOpen = false">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="6"/>
                        </svg>
                    </button>
                </div>

                <div class="p-4 border-b border-line bg-canvas/40 flex items-center justify-between text-[0.785rem] text-ink-muted">
                    <span class="font-mono">@AppState.SelectedDocument.Passages.Count chunks indexed</span>
                    <span class="text-accent font-medium">Stored in SQLite</span>
                </div>

                <div class="flex-1 overflow-y-auto p-4 flex flex-col gap-3">
                    @foreach (var passage in AppState.SelectedDocument.Passages)
                    {
                        <div class="bg-surface-raised border border-line rounded-xl p-3.5 hover:border-line-strong transition-all">
                            <div class="flex items-center justify-between text-[0.72rem] text-ink-muted mb-2 border-b border-line/60 pb-1.5">
                                <span class="font-mono text-accent">Chunk #@passage.Id</span>
                                <span class="bg-canvas border border-line px-2 py-0.5 rounded font-mono text-[0.68rem]">Page @passage.PageNumber</span>
                            </div>
                            <p class="text-[0.82rem] text-ink-secondary leading-relaxed select-text">
                                @passage.Content
                            </p>
                        </div>
                    }
                </div>
            </aside>
        }
    </div>
}
else if (AppState.ActiveView == "library")
{
    <!-- LIBRARY VIEW -->
    <div class="flex-1 overflow-y-auto px-4 py-6 sm:px-8 sm:py-8 lg:px-14 lg:py-9">
        <div class="mb-6 sm:mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl sm:text-[1.85rem] font-bold tracking-tight text-ink mb-1.5">Library Collections</h1>
                <p class="text-ink-secondary text-sm sm:text-[0.9rem]">Create folders to group related documents and study materials together.</p>
            </div>
            <button class="bg-accent hover:bg-accent-hover text-white rounded-lg px-4 py-2 text-[0.825rem] font-semibold flex items-center gap-2 cursor-pointer transition-colors shadow-sm self-start sm:self-auto"
                    @onclick="() => isNewFolderModalOpen = true">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>New Folder</span>
            </button>
        </div>

        <!-- Folders Grid -->
        <div class="mb-4 flex items-center justify-between">
            <h2 class="text-base font-semibold text-ink">Folders (@AppState.Folders.Count)</h2>
            @if (activeFilterFolderId.HasValue)
            {
                <button class="text-xs text-accent hover:underline cursor-pointer" @onclick="() => activeFilterFolderId = null">
                    Show All Documents
                </button>
            }
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-3 sm:gap-4 mb-8">
            <!-- All Documents Card -->
            <div class="bg-surface border @(!activeFilterFolderId.HasValue ? "border-accent bg-surface-raised" : "border-line") rounded-xl p-4 shadow-card hover:border-accent-border transition-all cursor-pointer flex items-center justify-between"
                 @onclick="() => activeFilterFolderId = null">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-surface-raised border border-line flex items-center justify-center text-accent">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                        </svg>
                    </div>
                    <div>
                        <div class="font-semibold text-ink text-[0.875rem]">All Documents</div>
                        <div class="text-[0.72rem] text-ink-muted">@AppState.Documents.Count items</div>
                    </div>
                </div>
            </div>

            @foreach (var folder in AppState.Folders)
            {
                <div class="bg-surface border @(activeFilterFolderId == folder.Id ? "border-accent bg-surface-raised" : "border-line") rounded-xl p-4 shadow-card hover:border-accent-border transition-all cursor-pointer flex items-center justify-between group"
                     @onclick="() => activeFilterFolderId = folder.Id">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-9 h-9 rounded-lg bg-surface-raised border border-accent-border flex items-center justify-center text-accent flex-shrink-0">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/>
                            </svg>
                        </div>
                        <div class="min-w-0">
                            <div class="font-semibold text-ink text-[0.875rem] truncate">@folder.Name</div>
                            <div class="text-[0.72rem] text-ink-muted">@AppState.Documents.Count(d => d.ProjectId == folder.Id) files</div>
                        </div>
                    </div>
                    <button class="opacity-0 group-hover:opacity-100 text-ink-muted hover:text-danger p-1 rounded transition-opacity"
                            title="Delete folder"
                            @onclick:stopPropagation="true"
                            @onclick="() => AppState.DeleteFolderAsync(folder.Id)">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                        </svg>
                    </button>
                </div>
            }
        </div>

        <!-- Filtered Documents Header -->
        <div class="mb-4 flex items-center justify-between">
            <h2 class="text-base font-semibold text-ink">
                @(activeFilterFolderId.HasValue ? $"Documents in {AppState.Folders.FirstOrDefault(f => f.Id == activeFilterFolderId)?.Name ?? "Folder"}" : "All Documents")
            </h2>
            <span class="text-xs text-ink-muted font-mono">@FilteredLibraryDocs.Count() items</span>
        </div>

        <!-- Documents Grid -->
        @if (!FilteredLibraryDocs.Any())
        {
            <div class="border border-line rounded-xl bg-surface/50 p-8 text-center text-ink-muted text-sm">
                No documents found in this folder. You can assign documents to this folder below.
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-4 sm:gap-5">
                @foreach (var doc in FilteredLibraryDocs)
                {
                    <div class="bg-surface border border-line rounded-[14px] overflow-hidden transition-all duration-200 flex flex-col shadow-card hover:border-accent-border hover:shadow-card-hover group">
                        <div class="h-[120px] w-full relative overflow-hidden bg-surface-raised cursor-pointer" @onclick="() => AppState.SelectDocument(doc.Id)">
                            <img src="@(doc.CoverUrl ?? "assets/notebook-covers/cover-01.jpg")" alt="Cover" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                            <div class="absolute inset-0 bg-gradient-to-b from-black/5 to-black/75"></div>
                        </div>
                        <div class="p-3.5 flex flex-col flex-1">
                            <div class="text-[0.875rem] font-semibold text-ink leading-snug mb-2 line-clamp-2 cursor-pointer" @onclick="() => AppState.SelectDocument(doc.Id)">
                                @doc.Filename
                            </div>
                            
                            <!-- Folder assignment selector -->
                            <div class="mt-auto pt-2 border-t border-line/60 flex items-center justify-between gap-2 text-[0.7rem]">
                                <span class="text-ink-muted flex-shrink-0">Folder:</span>
                                <select class="bg-canvas border border-line text-ink rounded px-1.5 py-0.5 text-[0.7rem] truncate outline-none cursor-pointer"
                                        value="@(doc.ProjectId?.ToString() ?? "")"
                                        @onchange="(e) => OnDocFolderChanged(doc.Id, e.Value?.ToString())">
                                    <option value="">None (Unfiled)</option>
                                    @foreach (var f in AppState.Folders)
                                    {
                                        <option value="@f.Id">@f.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- New Folder Modal -->
    @if (isNewFolderModalOpen)
    {
        <div class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
            <div class="bg-surface border border-line rounded-2xl p-6 w-full max-w-sm shadow-2xl animate-scale-in">
                <h3 class="text-lg font-bold text-ink mb-1">Create New Folder</h3>
                <p class="text-xs text-ink-muted mb-4">Group and categorize connected documents together.</p>
                <input type="text" 
                       class="w-full bg-canvas border border-line focus:border-accent rounded-lg px-3 py-2 text-sm text-ink outline-none mb-4"
                       placeholder="e.g. Physics 101, Biology Research"
                       @bind="newFolderName"
                       @bind:event="oninput"
                       @onkeydown="HandleFolderInputKeyDown" />
                <div class="flex items-center justify-end gap-2">
                    <button class="px-3.5 py-1.5 rounded-lg text-xs font-medium text-ink-secondary hover:text-ink cursor-pointer"
                            @onclick="() => isNewFolderModalOpen = false">
                        Cancel
                    </button>
                    <button class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-accent hover:bg-accent-hover text-white cursor-pointer transition-colors"
                            @onclick="SubmitNewFolder">
                        Create Folder
                    </button>
                </div>
            </div>
        </div>
    }
}
else if (AppState.ActiveView == "quiz")
{
    <!-- QUIZ STUDY MODE -->
    <div class="flex-1 overflow-y-auto px-4 py-6 sm:px-8 sm:py-8 lg:px-14 lg:py-10 max-w-[860px] mx-auto w-full">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
            <button class="bg-surface-raised border border-line text-ink-secondary hover:text-ink hover:border-accent-border hover:bg-surface-hover rounded-lg px-3 py-1.5 text-[0.8rem] font-medium flex items-center gap-1.5 cursor-pointer transition-all" @onclick='() => AppState.SetView("workspace")'>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                <span>Back to Workspace</span>
            </button>

            @if (AppState.SelectedDocument != null)
            {
                <button class="bg-accent hover:bg-accent-hover text-white border-none rounded-lg px-3.5 py-1.5 text-[0.8rem] font-semibold flex items-center gap-2 cursor-pointer transition-colors shadow-sm disabled:opacity-50" @onclick="GenerateQuiz" disabled="@AppState.IsAiBusy">
                    @if (AppState.IsAiBusy)
                    {
                        <svg class="animate-spin w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle class="opacity-25" cx="12" cy="12" r="10"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                        </svg>
                        <span>Generating...</span>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
                        </svg>
                        <span>Generate New Quiz</span>
                    }
                </button>
            }
        </div>

        <div class="mb-6 sm:mb-8">
            <div class="flex items-center gap-2 mb-1">
                <span class="w-2 h-2 rounded-full bg-accent"></span>
                <span class="text-[0.72rem] font-bold uppercase tracking-wider text-accent font-mono truncate">
                    @(AppState.SelectedDocument?.Filename ?? "Document Quiz")
                </span>
            </div>
            <h1 class="text-2xl sm:text-[1.85rem] font-bold tracking-tight text-ink mb-1.5">Interactive Knowledge Assessment</h1>
            <p class="text-ink-secondary text-sm sm:text-[0.9rem]">Multiple-choice quiz strictly grounded in the document text with direct citations.</p>
        </div>

        @if (AppState.SampleQuiz == null || AppState.SampleQuiz.Count == 0)
        {
            <div class="border border-line rounded-2xl bg-surface p-6 sm:p-12 text-center flex flex-col items-center justify-center">
                <div class="w-12 h-12 rounded-xl bg-surface-raised border border-accent-border flex items-center justify-center text-accent mb-4">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>
                    </svg>
                </div>
                <h3 class="text-[1.1rem] font-semibold text-ink mb-2">No Quiz Generated Yet</h3>
                <p class="text-ink-secondary text-[0.85rem] max-w-md mb-6 leading-relaxed">
                    Generate an AI quiz from the passages of <strong class="text-ink">@(AppState.SelectedDocument?.Filename ?? "this document")</strong> to test your understanding of key concepts.
                </p>
                <button class="bg-accent hover:bg-accent-hover text-white border-none rounded-lg px-5 py-2.5 text-[0.875rem] font-semibold cursor-pointer transition-colors flex items-center gap-2" @onclick="GenerateQuiz" disabled="@(AppState.SelectedDocument == null || AppState.IsAiBusy)">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                    </svg>
                    <span>Generate Quiz from Document</span>
                </button>
            </div>
        }
        else
        {
            @for (int i = 0; i < AppState.SampleQuiz.Count; i++)
            {
                var qIndex = i;
                var item = AppState.SampleQuiz[qIndex];
                var selectedAns = quizSelections.ContainsKey(qIndex) ? quizSelections[qIndex] : (int?)null;

                <div class="bg-surface border border-line rounded-[18px] p-5 sm:p-8 shadow-card mb-5 sm:mb-6">
                    <div class="flex flex-wrap justify-between items-center gap-2 mb-4">
                        <span class="text-[0.75rem] font-bold text-accent uppercase tracking-wider font-mono">Question @(qIndex + 1) of @AppState.SampleQuiz.Count</span>
                        <span class="text-[0.72rem] text-ink-muted bg-surface-raised px-2.5 py-1 rounded-md border border-line font-mono">Citation: @item.Citation</span>
                    </div>
                    <h3 class="text-base sm:text-[1.1rem] font-semibold text-ink mb-4 sm:mb-5 leading-snug">@item.Question</h3>

                    @for (int o = 0; o < item.Options.Count; o++)
                    {
                        var optIndex = o;
                        var isSelected = selectedAns == optIndex;
                        var isCorrect = hasSubmittedQuiz && optIndex == item.AnswerIndex;
                        var isWrong = hasSubmittedQuiz && isSelected && optIndex != item.AnswerIndex;

                        var buttonClass = "border-line bg-surface-raised text-ink hover:border-accent hover:bg-surface-hover";
                        if (isCorrect)
                        {
                            buttonClass = "border-emerald-500/80 bg-emerald-500/15 text-emerald-400 font-semibold";
                        }
                        else if (isWrong)
                        {
                            buttonClass = "border-rose-500/80 bg-rose-500/15 text-rose-400 font-semibold";
                        }
                        else if (isSelected)
                        {
                            buttonClass = "border-accent bg-accent/15 text-accent font-semibold";
                        }

                        <button class="flex items-center w-full px-3.5 sm:px-4 py-3 rounded-xl border text-[0.875rem] text-left cursor-pointer mb-2.5 transition-all @buttonClass" @onclick="() => quizSelections[qIndex] = optIndex">
                            <span class="w-6 font-bold text-ink-muted flex-shrink-0">@((char)('A' + optIndex)).</span>
                            <span class="flex-1">@item.Options[optIndex]</span>
                            @if (hasSubmittedQuiz && isCorrect)
                            {
                                <svg class="w-4 h-4 text-emerald-400 ml-2 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                            }
                            else if (hasSubmittedQuiz && isWrong)
                            {
                                <svg class="w-4 h-4 text-rose-400 ml-2 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="6"/>
                                </svg>
                            }
                        </button>
                    }

                    @if (hasSubmittedQuiz)
                    {
                        <div class="bg-black/30 border-l-[3px] border-accent rounded-r-[10px] p-3.5 text-[0.825rem] leading-relaxed text-ink-secondary mt-4 chat-prose">
                            <strong class="text-ink">Explanation:</strong> @TextFormatter.ToFormattedHtml(item.Explanation)
                        </div>
                    }
                </div>
            }

            <div class="flex flex-wrap items-center gap-4 mt-6">
                @if (!hasSubmittedQuiz)
                {
                    <button class="bg-accent hover:bg-accent-hover text-white border-none rounded-lg px-6 py-2.5 text-[0.95rem] font-semibold cursor-pointer transition-colors shadow-sm" @onclick="() => hasSubmittedQuiz = true">
                        Submit Assessment
                    </button>
                }
                else
                {
                    var correctCount = AppState.SampleQuiz.Count(q => quizSelections.ContainsKey(AppState.SampleQuiz.IndexOf(q)) && quizSelections[AppState.SampleQuiz.IndexOf(q)] == q.AnswerIndex);
                    <div class="flex flex-wrap items-center gap-4">
                        <span class="text-[1.05rem] font-bold text-ink bg-surface-raised border border-line px-4 py-2 rounded-lg">
                            Score: @correctCount / @AppState.SampleQuiz.Count (@((int)((double)correctCount / AppState.SampleQuiz.Count * 100))%)
                        </span>
                        <button class="bg-surface-raised border border-line text-ink hover:bg-surface-hover rounded-lg px-4 py-2 text-[0.875rem] font-medium cursor-pointer transition-colors" @onclick="() => { hasSubmittedQuiz = false; quizSelections.Clear(); }">
                            Retake Quiz
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}
else if (AppState.ActiveView == "flashcards")
{
    <!-- FLASHCARDS STUDY MODE -->
    <div class="flex-1 overflow-y-auto px-4 py-6 sm:px-8 sm:py-8 lg:px-14 lg:py-10 max-w-[860px] mx-auto w-full">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
