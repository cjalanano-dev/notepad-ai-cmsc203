                    <button class="bg-accent hover:bg-accent-hover text-white border-none rounded-lg px-4 sm:px-5 py-2 text-[0.85rem] font-semibold cursor-pointer transition-colors disabled:opacity-40 disabled:cursor-not-allowed" @onclick="NextCard" disabled="@(currentCardIndex == AppState.SampleFlashcards.Count - 1)">
