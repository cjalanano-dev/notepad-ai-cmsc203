@code {
    private bool isUploading = false;
    private string uploadProgressMessage = "Processing document...";
    private bool isChatVisible = true;
    private bool isSourcesPanelOpen = false;
    private string chatInputText = string.Empty;
    private Dictionary<int, int> quizSelections = new();
    private bool hasSubmittedQuiz = false;
    private int currentCardIndex = 0;
    private bool isCardFlipped = false;
    private int? activeFilterFolderId = null;
    private bool isNewFolderModalOpen = false;
    private string newFolderName = string.Empty;

    private IEnumerable<DocumentItem> FilteredLibraryDocs =>
        activeFilterFolderId.HasValue 
            ? AppState.Documents.Where(d => d.ProjectId == activeFilterFolderId.Value) 
            : AppState.Documents;

    private async Task SubmitNewFolder()
    {
        if (string.IsNullOrWhiteSpace(newFolderName)) return;
        await AppState.CreateFolderAsync(newFolderName);
        newFolderName = string.Empty;
        isNewFolderModalOpen = false;
    }

    private async Task HandleFolderInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitNewFolder();
        }
        else if (e.Key == "Escape")
        {
            isNewFolderModalOpen = false;
        }
    }

    private async Task OnDocFolderChanged(int docId, string? folderVal)
    {
        int? folderId = int.TryParse(folderVal, out var fid) ? fid : null;
        await AppState.AssignDocumentToFolderAsync(docId, folderId);
    }

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
        if (AppState.LlmService is BlazorApp1.Services.WebLlmService webLlm)
        {
            webLlm.OnProgressChanged += () => InvokeAsync(StateHasChanged);
        }
    }

    private async Task InitializeWebLlmModel()
    {
        if (AppState.LlmService is BlazorApp1.Services.WebLlmService webLlm)
        {
            try
            {
                await webLlm.InitializeModelAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[WebLLM] Error: {ex.Message}");
            }
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isUploading = true;
        uploadProgressMessage = $"Reading {file.Name}...";
        StateHasChanged();

        try
        {
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            string extractedText = string.Empty;

            if (ext == ".pdf")
            {
                uploadProgressMessage = "Extracting PDF text layers...";
                StateHasChanged();

                using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024); // up to 20MB
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();

                var jsonPages = await JSRuntime.InvokeAsync<string>("docParser.extractPdfText", bytes);
                if (!string.IsNullOrWhiteSpace(jsonPages))
                {
                    var pages = System.Text.Json.JsonSerializer.Deserialize<List<PdfPageExtraction>>(jsonPages, new System.Text.Json.JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                    if (pages != null && pages.Count > 0)
                    {
                        extractedText = string.Join("\n\n", pages.Select(p => $"--- Page {p.PageNumber} ---\n{p.Content}"));
                    }
                }
            }
            else
            {
                // .txt or .md
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var reader = new StreamReader(stream);
                extractedText = await reader.ReadToEndAsync();
            }

            if (!string.IsNullOrWhiteSpace(extractedText))
            {
                uploadProgressMessage = "Generating grounded mind map & storing into SQLite...";
                StateHasChanged();
                await AppState.AddDocumentWithContentAsync(file.Name, extractedText);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[File Upload Error] {ex.Message}");
        }
        finally
        {
            isUploading = false;
            uploadProgressMessage = "Processing document...";
            StateHasChanged();
        }
    }

    private class PdfPageExtraction
    {
        public int PageNumber { get; set; }
        public string Content { get; set; } = string.Empty;
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(chatInputText)) return;
        var text = chatInputText;
        chatInputText = string.Empty;
        await AppState.AddChatMessageAsync(text);
    }

    private async Task GenerateQuiz()
    {
        hasSubmittedQuiz = false;
        quizSelections.Clear();
        await AppState.GenerateQuizForSelectedDocumentAsync();
    }

    private async Task GenerateCards()
    {
        currentCardIndex = 0;
        isCardFlipped = false;
        await AppState.GenerateFlashcardsForSelectedDocumentAsync();
    }

    private void NextCard()
    {
        if (currentCardIndex < AppState.SampleFlashcards.Count - 1)
        {
            currentCardIndex++;
            isCardFlipped = false;
        }
    }

    private void PrevCard()
    {
        if (currentCardIndex > 0)
        {
            currentCardIndex--;
            isCardFlipped = false;
        }
    }

    private async Task EvaluateEssay()
    {
        if (string.IsNullOrWhiteSpace(AppState.SampleEssay.Submission)) return;
        await AppState.GradeEssaySubmissionAsync(AppState.SampleEssay.Submission);
    }

    private DotNetObjectReference<Home>? dotNetHelper;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AppState.InitializeSqliteAsync();
        }

        if (AppState.ActiveView == "workspace")
        {
            dotNetHelper ??= DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("conceptMapInteractions.init", dotNetHelper);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing concept map JS: {ex.Message}");
            }
        }
    }

    [JSInvokable]
    public void OnNodeDraggedJs(int nodeId, double x, double y)
    {
        var node = AppState.CurrentNodes.FirstOrDefault(n => n.Id == nodeId);
        if (node != null)
        {
            node.X = x;
            node.Y = y;
        }
    }

    private async Task ZoomIn()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("conceptMapInteractions.zoomIn");
        }
        catch { }
    }

    private async Task ZoomOut()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("conceptMapInteractions.zoomOut");
        }
        catch { }
    }

    private async Task ResetCanvasView()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("conceptMapInteractions.resetTransform");
        }
        catch { }
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        dotNetHelper?.Dispose();
    }
}
