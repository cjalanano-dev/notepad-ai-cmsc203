                    @(AppState.SelectedDocument?.Filename ?? "Document Flashcards")
                </span>
            </div>
            <h1 class="text-2xl sm:text-[1.85rem] font-bold tracking-tight text-ink mb-1.5">Interactive Concept Flashcards</h1>
            <p class="text-ink-secondary text-sm sm:text-[0.9rem]">
                @(AppState.SampleFlashcards.Count > 0 ? $"Card {currentCardIndex + 1} of {AppState.SampleFlashcards.Count} • Click anywhere to flip" : "Review key definitions and core topics.")
            </p>
        </div>

        @if (AppState.SampleFlashcards == null || AppState.SampleFlashcards.Count == 0)
        {
            <div class="border border-line rounded-2xl bg-surface p-6 sm:p-12 text-center flex flex-col items-center justify-center">
                <div class="w-12 h-12 rounded-xl bg-surface-raised border border-accent-border flex items-center justify-center text-accent mb-4">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.9a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
                    </svg>
                </div>
                <h3 class="text-[1.1rem] font-semibold text-ink mb-2">No Flashcards Available</h3>
                <p class="text-ink-secondary text-[0.85rem] max-w-md mb-6 leading-relaxed">
                    Generate an interactive deck from <strong class="text-ink">@(AppState.SelectedDocument?.Filename ?? "this document")</strong> to memorize key terms and concepts.
                </p>
                <button class="bg-accent hover:bg-accent-hover text-white border-none rounded-lg px-5 py-2.5 text-[0.875rem] font-semibold cursor-pointer transition-colors flex items-center gap-2" @onclick="GenerateCards" disabled="@(AppState.SelectedDocument == null || AppState.IsAiBusy)">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                    </svg>
                    <span>Generate Flashcards from Document</span>
                </button>
            </div>
        }
        else
        {
            if (currentCardIndex >= AppState.SampleFlashcards.Count) currentCardIndex = 0;
            var card = AppState.SampleFlashcards[currentCardIndex];

            <div class="min-h-[240px] sm:min-h-[260px] bg-surface-raised border border-line hover:border-accent hover:-translate-y-0.5 rounded-2xl flex flex-col items-center justify-center text-center p-6 sm:p-10 cursor-pointer transition-all select-none shadow-card relative group" @onclick="() => isCardFlipped = !isCardFlipped">
                <div class="absolute top-4 right-4 flex items-center gap-2">
                    <span class="text-[0.7rem] sm:text-[0.72rem] font-mono text-ink-muted bg-surface px-2 sm:px-2.5 py-1 rounded-md border border-line">
                        Citation: @card.Citation
