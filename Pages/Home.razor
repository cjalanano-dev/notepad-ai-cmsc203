                </div>

                <div class="text-[0.72rem] sm:text-[0.75rem] font-bold uppercase tracking-wider text-accent mb-4 mt-6 sm:mt-0">
                    @(isCardFlipped ? "Explanation / Verified Answer" : "Concept Prompt")
                </div>
                <div class="text-lg sm:text-[1.25rem] font-semibold text-ink max-w-[580px] leading-relaxed">
                    @(isCardFlipped ? card.Back : card.Front)
                </div>
                <div class="mt-6 text-[0.75rem] text-ink-muted">
                    Click anywhere to flip card
                </div>
            </div>

            <div class="flex items-center justify-between mt-6">
                <div class="flex items-center gap-2">
                    <button class="bg-surface-raised border border-line text-ink-secondary hover:text-ink hover:border-line-strong hover:bg-surface-hover rounded-lg px-3.5 sm:px-4 py-2 text-[0.85rem] font-medium cursor-pointer transition-all disabled:opacity-40 disabled:cursor-not-allowed" @onclick="PrevCard" disabled="@(currentCardIndex == 0)">
                        Previous
